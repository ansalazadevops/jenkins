pipeline {
    agent any
    stages {
        stage('Agent Package Test') {
            steps {
                sh '''
                echo "Running on: `hostname`"; 
                uname -a; 
                cat /etc/os-release;
                git --version;
                java --version;
                python3 --version;
                pip3 --version;
                terraform --version
                '''
            }
        }
    }
}
